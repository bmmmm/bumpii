{
  "name": "bumpii",
  "version": "0.1.0",
  "description": "Read what actually changed in the CLI tools and containers you run, judged against your own usage — then bump them.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "bumpii": "bin/bumpii"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "scripts": {
    "preinstall": "node -e \"if(!(process.env.npm_config_user_agent||'').startsWith('pnpm')){console.error('\\nUse pnpm, not npm/yarn: https://pnpm.io/installation\\n');process.exit(1)}\"",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "node --test --test-timeout=60000",
    "start": "node src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
